[Unit]
Description=Rackdeck Connect Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rackdeck
WorkingDirectory=/var/lib/rackdeck-relay
Environment=RACKDECK_RELAY_PORT=7430
Environment=RACKDECK_RELAY_AUDIENCE=connect.rackdeck.dev
Environment=RACKDECK_RELAY_DB=/var/lib/rackdeck-relay/relay.db
Environment=RACKDECK_RELAY_REQUIRE_SUBSCRIPTION=1
Environment=RACKDECK_PUBLIC_URL=https://connect.rackdeck.dev
Environment=RACKDECK_MAIL_FROM=Rackdeck <login@rackdeck.dev>
# Secrets live here (chmod 600, owned by root):
#   STRIPE_SECRET_KEY=sk_live_...
#   RACKDECK_STRIPE_PRICE_ID=price_...
#   RACKDECK_STRIPE_WEBHOOK_SECRET=whsec_...
#   RESEND_API_KEY=re_...
#   RACKDECK_SESSION_SECRET=<openssl rand -hex 32>
EnvironmentFile=/etc/rackdeck-relay.env
ExecStart=/usr/local/bin/rackdeck-relay
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
